{
  "name": "@imlargo/air",
  "type": "module",
  "version": "2.1.0",
  "description": "A tiny, modern HTTP client for TypeScript. Built on native fetch.",
  "license": "MIT",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imlargo/air.git"
  },
  "homepage": "https://github.com/imlargo/air#readme",
  "bugs": {
    "url": "https://github.com/imlargo/air/issues"
  },
  "keywords": [
    "fetch",
    "http",
    "http-client",
    "esm",
    "typescript",
    "retry",
    "sse"
  ],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.29.2",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./retry": {
      "types": "./dist/retry.d.mts",
      "default": "./dist/retry.mjs"
    },
    "./refresh": {
      "types": "./dist/refresh.d.mts",
      "default": "./dist/refresh.mjs"
    },
    "./progress": {
      "types": "./dist/progress.d.mts",
      "default": "./dist/progress.mjs"
    },
    "./form": {
      "types": "./dist/form.d.mts",
      "default": "./dist/form.mjs"
    },
    "./query": {
      "types": "./dist/query.d.mts",
      "default": "./dist/query.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json && tsc -p bench/tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm build && pnpm --dir bench install && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "smoke": "pnpm build && node scripts/smoke.ts",
    "examples": "pnpm build && node scripts/examples.ts",
    "demo": "pnpm build && node examples/demo.ts",
    "bench": "pnpm build && pnpm --dir bench install && node bench/run.ts",
    "prepublishOnly": "pnpm build",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "eslint": "^10.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "tsdown": "^0.22.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
