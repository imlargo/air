{
  "name": "@korastd/air",
  "type": "module",
  "version": "0.3.0",
  "description": "A tiny, modern HTTP client for TypeScript. Built on native fetch.",
  "license": "MIT",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imlargo/air.git"
  },
  "homepage": "https://github.com/imlargo/air#readme",
  "bugs": {
    "url": "https://github.com/imlargo/air/issues"
  },
  "keywords": [
    "fetch",
    "http",
    "http-client",
    "esm",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.29.2",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "smoke": "pnpm build && node scripts/smoke.mjs",
    "demo": "pnpm build && node examples/demo.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "tsdown": "^0.22.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
